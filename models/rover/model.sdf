<?xml version="1.0"?>
<!--
  Vierrädriger Rover mit Ackermann-Lenkung.
  - Vorderräder sitzen an Achsschenkeln (Lenkgelenke um die z-Achse). Das
    Plugin stellt kurveninneres und -äußeres Rad unterschiedlich ein
    (Ackermann-Bedingung); steering_limit 0,7 rad begrenzt den Wendekreis,
    die Gelenkanschläge (±0,85 rad) lassen dem Innenrad dafür genug Weg.
  - Angetrieben werden die Hinterräder (Hinterradantrieb).
  - Radstand 0,56 m, Spurweite 0,62 m, Radradius 0,15 m
    → minimaler Wendekreisradius ≈ Radstand / sin(0,7) ≈ 0,87 m.
  Gesteuert über gz.msgs.Twist auf /cmd_vel (linear.x + angular.z werden in
  Lenkwinkel umgerechnet). Rad-Odometrie auf /odom (Bezugspunkt Mitte
  Hinterachse, x = -0,28 m); die TF odom → base_footprint erzeugt der EKF auf
  ROS-Seite aus Rad-Odometrie + Gyroskop (ros/config/ekf.yaml).
  Sensoren: Kamera (/camera), je ein 185°-Lidar vorne (/lidar) und hinten
  (/lidar_rear), IMU (/imu).
-->
<sdf version="1.9">
  <model name="rover">
    <pose>0 0 0 0 0 0</pose>

    <!-- ================= Chassis ================= -->
    <link name="chassis">
      <pose>0 0 0.22 0 0 0</pose>
      <inertial>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.3625</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.85</iyy><iyz>0</iyz>
          <izz>1.1125</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.8 0.5 0.2</size></box></geometry>
      </collision>
      <visual name="body">
        <geometry><box><size>0.8 0.5 0.2</size></box></geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <!-- Solarpanel auf dem Deck -->
      <visual name="solar_panel">
        <pose>-0.05 0 0.105 0 0 0</pose>
        <geometry><box><size>0.6 0.46 0.01</size></box></geometry>
        <material>
          <ambient>0.05 0.08 0.25 1</ambient>
          <diffuse>0.1 0.15 0.45 1</diffuse>
          <specular>0.8 0.8 0.9 1</specular>
        </material>
      </visual>
      <!-- Mast -->
      <visual name="mast">
        <pose>0.3 0 0.3 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
      <visual name="camera_head">
        <pose>0.32 0 0.52 0 0 0</pose>
        <geometry><box><size>0.08 0.16 0.06</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <!-- Antenne -->
      <visual name="antenna">
        <pose>-0.3 0.15 0.25 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.3</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.6 0.2 1</ambient>
          <diffuse>0.8 0.7 0.2 1</diffuse>
        </material>
      </visual>

      <!-- Kamera auf dem Mast -->
      <sensor name="camera" type="camera">
        <pose>0.37 0 0.52 0 0.15 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>camera</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>

      <!-- Tiefenkamera an derselben Stelle wie die Farbkamera, gleiches
           Sichtfeld, halbe Auflösung (Pixel (u, v) der Farbkamera = (u/2, v/2)).
           Damit rechnet ros/vlm Bounding-Boxen des VLM in Kartenpunkte um. -->
      <sensor name="depth_camera" type="depth_camera">
        <pose>0.37 0 0.52 0 0.15 0</pose>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <topic>depth_camera</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera>
          <!-- sonst landet die Intrinsik auf /camera_info, gemischt mit der Farbkamera -->
          <camera_info_topic>depth_camera/camera_info</camera_info_topic>
          <horizontal_fov>1.3</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>12</far>
          </clip>
        </camera>
      </sensor>

      <!-- IMU mit realistischem Rauschen (MEMS-Gyroskop) -->
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev><bias_mean>0.0005</bias_mean></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev><bias_mean>0.0005</bias_mean></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev><bias_mean>0.0005</bias_mean></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ================= Lidar vorne =================
         Scanner an der Stoßstange (185°), damit weder Mast und Antenne noch
         die Räder im Scan auftauchen. Höhe 0,27 m: sieht Stuhlsäulen, Regale
         und die Sichtblenden der Schreibtische. -->
    <link name="lidar_link">
      <pose>0.50 0 0.27 0 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0003</iyy><iyz>0</iyz>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>lidar</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>370</samples>
              <resolution>1</resolution>
              <min_angle>-1.6</min_angle>
              <max_angle>1.6</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>chassis</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ================= Lidar hinten =================
         Gleicher Scanner, nach hinten gerichtet – damit der Rover beim
         Rangieren rückwärts nicht blind ist. -->
    <link name="lidar_rear_link">
      <pose>-0.50 0 0.27 0 0 3.14159265</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0003</iyy><iyz>0</iyz>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar_rear" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>lidar_rear</topic>
        <gz_frame_id>lidar_rear_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>370</samples>
              <resolution>1</resolution>
              <min_angle>-1.6</min_angle>
              <max_angle>1.6</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_rear_joint" type="fixed">
      <parent>chassis</parent>
      <child>lidar_rear_link</child>
    </joint>

    <!-- ================= Achsschenkel (Lenkung) =================
         Die Lenkachse geht durch die Radmitte (Spreizung = Spurweite). -->
    <link name="front_left_steering_link">
      <pose>0.28 0.31 0.15 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0005</iyy><iyz>0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="knuckle">
        <pose>0 -0.07 0 0 0 0</pose>
        <geometry><box><size>0.06 0.04 0.06</size></box></geometry>
        <material>
          <ambient>0.5 0.1 0.1 1</ambient>
          <diffuse>0.7 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="front_right_steering_link">
      <pose>0.28 -0.31 0.15 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0005</iyy><iyz>0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="knuckle">
        <pose>0 0.07 0 0 0 0</pose>
        <geometry><box><size>0.06 0.04 0.06</size></box></geometry>
        <material>
          <ambient>0.5 0.1 0.1 1</ambient>
          <diffuse>0.7 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ================= Räder =================
         Die Rad-Links sind nicht rotiert; nur Visual/Collision werden um
         die X-Achse gedreht. So ist die Radachse einfach 0 1 0. -->
    <link name="front_left_wheel">
      <pose>0.28 0.31 0.15 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0096875</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.016875</iyy><iyz>0</iyz>
          <izz>0.0096875</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="hub">
        <pose>0 0.051 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.005</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="front_right_wheel">
      <pose>0.28 -0.31 0.15 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0096875</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.016875</iyy><iyz>0</iyz>
          <izz>0.0096875</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="hub">
        <pose>0 -0.051 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.005</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.28 0.31 0.15 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0096875</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.016875</iyy><iyz>0</iyz>
          <izz>0.0096875</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="hub">
        <pose>0 0.051 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.005</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.28 -0.31 0.15 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0096875</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.016875</iyy><iyz>0</iyz>
          <izz>0.0096875</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="hub">
        <pose>0 -0.051 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.005</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ================= Gelenke ================= -->
    <!-- Lenkgelenke -->
    <joint name="front_left_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.85</lower><upper>0.85</upper><effort>50</effort><velocity>3.0</velocity></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.85</lower><upper>0.85</upper><effort>50</effort><velocity>3.0</velocity></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>

    <!-- Vorderräder: frei drehend am Achsschenkel -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering_link</parent>
      <child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering_link</parent>
      <child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <!-- Hinterräder: angetrieben -->
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <!-- ================= Plugins ================= -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>0.62</kingpin_width>
      <steering_limit>0.7</steering_limit>
      <wheel_base>0.56</wheel_base>
      <wheel_separation>0.62</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <min_velocity>-0.6</min_velocity>
      <max_velocity>1.0</max_velocity>
      <min_acceleration>-2.0</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <!-- TF übernimmt der EKF; die Rad-TF wird nicht gebridged -->
      <tf_topic>/model/rover/tf_wheel_odometry</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <!-- Ground-Truth-Pose (z. B. zum Vergleich mit AMCL) -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>10</update_frequency>
    </plugin>
  </model>
</sdf>
