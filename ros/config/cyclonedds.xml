<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS nur über Loopback (lo0).
  macOS unterstützt auf lo0 kein Multicast, daher Discovery per Unicast an
  localhost. Bei ~25 Teilnehmern (Nav2 + Bridge + Tools) braucht es genügend
  Participant-Indizes.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo0" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="localhost"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
