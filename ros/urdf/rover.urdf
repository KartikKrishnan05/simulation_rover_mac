<?xml version="1.0"?>
<!--
  URDF des Rovers für robot_state_publisher und RViz.
  Maße und Gelenknamen entsprechen models/rover/model.sdf, damit die
  /joint_states aus Gazebo (Lenkung und Räder) direkt passen.
  base_footprint liegt am Boden unter der Mitte der Hinterachse – dort setzt
  die Odometrie des Ackermann-Plugins an (Fahrradmodell), und so erwarten es
  auch Pure Pursuit und Hybrid-A*. base_link ist die Chassismitte.
-->
<robot name="rover">
  <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="red"><color rgba="0.7 0.15 0.15 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.8 0.5 0.2"/></geometry>
      <material name="white"/>
    </visual>
    <visual>
      <origin xyz="0.3 0 0.3"/>
      <geometry><cylinder radius="0.02" length="0.4"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.28 0 0.22"/>
  </joint>

  <!-- Sensoren -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.50 0 0.05"/>
  </joint>

  <link name="lidar_rear_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="lidar_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_rear_link"/>
    <origin xyz="-0.50 0 0.05" rpy="0 0 3.14159265"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.08 0.16 0.06"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.37 0 0.52" rpy="0 0.15 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- Lenkung -->
  <link name="front_left_steering_link"/>
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steering_link"/>
    <origin xyz="0.28 0.31 -0.07"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.85" upper="0.85" effort="50" velocity="3"/>
  </joint>
  <link name="front_right_steering_link"/>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steering_link"/>
    <origin xyz="0.28 -0.31 -0.07"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.85" upper="0.85" effort="50" velocity="3"/>
  </joint>

  <!-- Räder -->
  <link name="front_left_wheel">
    <visual>
      <origin rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <origin rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_wheel">
    <visual>
      <origin rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.28 0.31 -0.07"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <origin rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.28 -0.31 -0.07"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
